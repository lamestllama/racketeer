(require rackunit racket/file racket/list racket/path racket/runtime-path)
(define-runtime-path environment "../vscode/racket-environment.rkt")
(define-runtime-path analysis "../vscode/workspace-analysis.rkt")
(dynamic-require environment #f)
(dynamic-require analysis #f)
(define (get name)
  (parameterize ([current-namespace (module->namespace analysis)]) (eval name)))
(define (fingerprints files)
  (for/hash ([file (in-list files)]) (values file ((get 'disk-fingerprint) file))))
(module+ test
  (for ([kind '(descriptor provider dependency)])
    (test-case (format "index observations invalidate after a ~a edit" kind)
      (define root (make-temporary-file "adapter-index~a" 'directory))
      (define engine ((get 'make-workspace-analysis)))
      (define (put name text)
        (define file (build-path root name))
        (make-directory* (path-only file))
        (display-to-file text file #:exists 'truncate)
        file)
      (dynamic-wind void
        (lambda ()
          (define source (put "program.rkt" "#lang racket/base\n(provide answer)\n(define answer 42)\n"))
          (define descriptor (put ".racketeer/language-adapters.rktd" "(#((file \"provider.rkt\") profile #f))\n"))
          (define provider (put ".racketeer/provider.rkt" "#lang racket/base\n(require \"dependency.rkt\")\n(provide profile)\n(define (profile request data) `(profile (match (language racket/base)) (editor (source-details ,mode))))\n"))
          (define dependency (put ".racketeer/dependency.rkt" "#lang racket/base\n(provide mode)\n(define mode 'sexp)\n"))
          ((get 'workspace-analysis-update!) engine
           (hasheq 'revision 1 'roots (list ((get 'path->uri) root)) 'documents '()))
          (define run ((get 'WorkspaceAnalysis-current-run) engine))
          (define cache (make-hash))
          (define (analyse before)
            ((get 'analyse) source (* 1024 1024) #f #f (hash) (list root) before cache))
          (define first (analyse (hash)))
          (define observed (list-ref first 4))
          (define before (fingerprints (map car (list-ref observed 2))))
          (define result (analyse before))
          (define record (list-ref result 4))
          (define reads (list-ref record 1))
          (define externals (list-ref record 2))
          (define resolutions (list-ref record 3))
          (for ([file (list descriptor provider dependency)])
            (check-not-false (assoc file reads)))
          (define held ((get 'Result) ((get 'analysis-basis) run) (list-ref result 1) (car result)
                                      (list-ref result 2) (car record) reads externals resolutions))
          (define all (remove-duplicates (cons source (append (map car reads) (map car externals)))))
          (define resolved (for/hash ([entry resolutions]) (values (car entry) ((get 'resolved-form) (car entry)))))
          (define (current?)
            (define disk (fingerprints all))
            ((get 'result-current?) held run source disk disk resolved))
          (check-true (current?))
          (call-with-output-file (case kind [(descriptor) descriptor] [(provider) provider] [else dependency])
            newline #:exists 'append)
          (check-false (current?))
          (unless (eq? kind 'descriptor)
            (check-exn #rx"analysis failed" (lambda () (analyse before))))
          (when (eq? kind 'descriptor)
            (check-exn #rx"analysis failed"
             (lambda ()
               ((get 'analyse) source (* 1024 1024) #f #f
                (hash descriptor "((profile (match (language racket/base)) (editor (expand? #f))))")
                (list root) (hash) (make-hash))))))
        (lambda ()
          ((get 'workspace-analysis-close!) engine)
          (delete-directory/files root))))))
