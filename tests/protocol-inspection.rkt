(require rackunit racket/port racket/promise racket/list racket/shared
         "../racketdap/protocol.rkt" "../racketdap/worker/inspect.rkt"
         (only-in "../racketdap/instrumentation/instrument.rkt" unavailable))
(module+ test
  (test-case "UTF-8 payload uses byte length and supports successive messages"
    (define out (open-output-bytes))
    (define message (hasheq 'text "😀λ" 'seq 1))
    (write-message message out) (write-message message out)
    (define in (open-input-bytes (get-output-bytes out)))
    (check-equal? (read-message in) message)
    (check-equal? (read-message in) message)
    (check-true (eof-object? (read-message in))))
  (for ([bytes (list #"Content-Length: 20\r\n\r\n{}"
                    #"Content-Length: 2\r\nContent-Length: 2\r\n\r\n{}"
                    #"Content-Length: 999999999\r\n\r\n"
                    #"Content-Length: 2\r\n"
                    #"Content-Length: 2\r\n\r\n[]")])
    (test-case "malformed or truncated transport input is rejected"
      (check-exn exn:fail? (lambda () (read-message (open-input-bytes bytes))))))
  (test-case "previews do not execute writers, force promises, or traverse cycles"
    (define effects 0)
    (struct custom () #:property prop:custom-write (lambda args (set! effects (add1 effects))))
    (define promise (delay (set! effects (add1 effects)) 10))
    (check-equal? (value-preview (custom)) "#<opaque value>")
    (check-equal? (value-preview promise) "#<promise>")
    (define cycle (box #f)) (set-box! cycle cycle)
    (check-true (< (string-length (value-preview cycle)) 100))
    (check-equal? effects 0)
    (define missing (unavailable 'uninitialized))
    (check-false (expandable? missing))
    (check-equal? (children missing 0 10) '()))
  (test-case "wrapped vectors are not accessed implicitly"
    (define effects 0)
    (define wrapped (chaperone-vector (vector 1)
                                    (lambda (v i value) (set! effects (add1 effects)) value)
                                    (lambda (v i value) value)))
    (check-false (expandable? wrapped))
    (check-equal? (children wrapped 0 100) '())
    (value-preview wrapped)
    (check-equal? effects 0))
  (test-case "structure fields use the debugger inspector without running user printers"
    (define effects 0)
    (define value
      (parameterize ([current-inspector (make-inspector)])
        (struct parent (first) #:mutable)
        (struct child parent (second [third #:auto]) #:auto-value 3
          #:property prop:custom-write (lambda args (set! effects (add1 effects)))
          #:property prop:object-name (lambda (_) (set! effects (add1 effects)) 'changed))
        (child 1 2)))
    (check-equal? (value-type value) "child")
    (check-equal? (value-preview value) "#<child 1 2 3>")
    (check-true (expandable? value))
    (check-equal? (children value 0 10) '(("0" . 1) ("1" . 2) ("2" . 3)))
    (check-equal? (children value 1 1) '(("1" . 2)))
    (check-equal? (children value 9 10) '())
    (check-equal? effects 0))
  (test-case "wrapped structures remain explicit and inaccessible structures stay opaque"
    (define effects 0)
    (define wrapped
      (parameterize ([current-inspector (make-inspector)])
        (struct item (value))
        (chaperone-struct (item 7) item-value (lambda (_ value) (set! effects (add1 effects)) value))))
    (check-equal? (value-type wrapped) "wrapped value")
    (check-false (expandable? wrapped))
    (check-equal? (children wrapped 0 10) '())
    (check-equal? effects 0)
    (struct private (value))
    (check-false (expandable? (private 7)))
    (check-equal? (children (private 7) 0 10) '()))
  (test-case "only visible structure fields are inspected, including prefab and cyclic values"
    (struct hidden (value))
    (define partial
      (parameterize ([current-inspector (make-inspector)])
        (struct child hidden (value))
        (child 7 8)))
    (check-equal? (value-type partial) "child")
    (check-equal? (children partial 0 10) '(("0" . 8)))
    (struct visible (value) #:transparent)
    (struct private-child visible (other))
    (check-false (expandable? (private-child 7 8)))
    (check-equal? (children (private-child 7 8) 0 10) '())
    (check-equal? (children '#s(pair 1 2) 0 2) '(("0" . 1) ("1" . 2)))
    (struct cycle (value) #:transparent #:mutable)
    (define v (cycle #f)) (set-cycle-value! v v)
    (check-equal? (value-preview v) "#<cycle #<cycle>>")
    (check-eq? (cdar (children v 0 1)) v))
  (test-case "vector children are paged and large exact numbers are bounded"
    (check-equal? (children '#(0 1 2 3 4) 1 2) '(("1" . 1) ("2" . 2)))
    (check-equal? (value-preview (expt 2 10000)) "<large exact number>"))
  (test-case "proper lists, improper tails, and nested lists remain readable"
    (check-equal? (value-preview '(copper silver gold)) "(copper silver gold)")
    (check-equal? (value-preview '((2 5) (8 11))) "((2 5) (8 11))")
    (check-equal? (value-preview '(north east . south)) "(north east . south)")
    (check-equal? (children '(copper silver gold) 0 2)
                  '(("car" . copper) ("cdr" silver gold)))
    (define ring (shared ([ring (cons 'again ring)]) ring))
    (check-equal? (value-preview ring) "(again . #<cycle>)"))
  (test-case "vectors and hashes preview contents without discarding child paging"
    (check-equal? (value-preview '#(spruce 17 #t)) "#(spruce 17 #t)")
    (check-equal? (value-preview (hasheq 'cedar '(3 9))) "#hasheq((cedar . (3 9)))")
    (check-equal? (value-preview (hash "width" 24)) "#hash((\"width\" . 24))")
    (check-equal? (value-preview #()) "#()")
    (check-equal? (value-preview (hash)) "#hash()")
    (check-equal? (children (hasheq 'cedar 9) 0 1) '(("0" cedar . 9)))
    (check-equal? (children (hasheq 'cedar 9) 1 1) '())
    (define ring (make-hasheq))
    (hash-set! ring 'self ring)
    (check-equal? (value-preview ring) "#hasheq((self . #<cycle>))"))
  (test-case "large, deep, and shared values keep a bounded preview"
    (define many (build-list 50000 values))
    (check-equal? (value-preview many) "(0 1 2 3 4 5 …)")
    (check-equal? (value-preview (make-vector 50000 'elm)) "#(elm elm elm elm elm elm …)")
    (define broad (for/hasheq ([i (in-range 50000)]) (values i i)))
    (define shared-value
      (for/fold ([value (box 'end)]) ([i (in-range 2000)]) (vector value value value value)))
    (for ([value (list broad shared-value (make-string 50000 #\newline)
                       (make-bytes 50000 0) (expt 2 2000))])
      (check-true (<= (string-length (value-preview value)) 161))))
  (test-case "visible structures preview numbered fields without guessing source names"
    (struct parcel (a b c d e f g h) #:transparent)
    (define value (parcel 'one 2 3 4 5 6 7 8))
    (check-equal? (value-preview value) "#<parcel one 2 3 4 5 6 …>")
    (check-equal? (children value 5 3) '(("5" . 6) ("6" . 7) ("7" . 8)))
    (check-equal? (value-preview '#s(coordinate 13 21)) "#<coordinate 13 21>"))
  (test-case "syntax objects expose bounded datum and paged source metadata"
    (define value (datum->syntax #f '(blend 7 (leaf 9)) '("orchard.rkt" 12 4 80 22)))
    (check-equal? (value-type value) "syntax")
    (check-true (expandable? value))
    (check-equal? (value-preview value) "#<syntax: (blend 7 (leaf 9))>")
    (check-equal? (map car (children value 0 20)) '("datum" "source" "line" "column" "position" "span"))
    (check-equal? (children value 1 20)
                  '(("source" . "orchard.rkt") ("line" . 12) ("column" . 4) ("position" . 80) ("span" . 22)))
    (check-equal? (children value 3 1) '(("column" . 4)))
    (check-equal? (children value 9 2) '())
    (check-equal? (value-preview (datum->syntax #f (build-list 10000 values)))
                  "#<syntax: (0 1 2 3 4 5 …)>")
    (check-equal? (value-preview (datum->syntax #f (cons #'tip #'(10 20))))
                  "#<syntax: (tip 10 20)>"))
  (test-case "syntax metadata and nested datum never run user printers"
    (define effects 0)
    (struct source ()
      #:property prop:custom-write (lambda args (set! effects (add1 effects)))
      #:property prop:object-name (lambda (_) (set! effects (add1 effects)) 'changed))
    (define origin (source))
    (define value (datum->syntax #f origin (list origin #f #f #f #f)))
    (check-equal? (value-preview value) "#<syntax: #<opaque value>>")
    (for ([child (in-list (children value 0 10))])
      (value-preview (cdr child)))
    (check-equal? effects 0))
  (test-case "procedure metadata does not call opaque callable structure properties"
    (define effects 0)
    (struct callable (fn)
      #:property prop:procedure 0
      #:property prop:object-name (lambda (_) (set! effects (add1 effects)) 'changed)
      #:property prop:custom-write (lambda args (set! effects (add1 effects)))
      #:property prop:arity-string (lambda (_) (set! effects (add1 effects)) "anything"))
    (define value (callable (lambda (x y) (set! effects (add1 effects)) x)))
    (check-equal? (value-preview value) "#<procedure>")
    (check-true (expandable? value))
    (check-equal? (children value 0 10) '(("arity" . 2)))
    (check-equal? (children value 1 10) '())
    (check-equal? (value-preview add1) "#<procedure:add1>")
    (check-equal? (children add1 0 1) '(("arity" . 1)))
    (check-equal? effects 0))
  (test-case "wrapped procedures, boxes, hashes, and nested containers stay inert"
    (define effects 0)
    (define wrapped-proc (chaperone-procedure (lambda (x) x)
                                            (lambda (x) (set! effects (add1 effects)) x)))
    (define wrapped-box (chaperone-box (box 18)
                                     (lambda (_ v) (set! effects (add1 effects)) v)
                                     (lambda (_ v) v)))
    (define wrapped-hash
      (chaperone-hash (make-hasheq '((x . 1)))
                     (lambda (_ key) (set! effects (add1 effects)) (values key (lambda (_hash _key v) v)))
                     (lambda (_ key v) (values key v))
                     (lambda (_ key) key)
                     (lambda (_ key) (set! effects (add1 effects)) key)))
    (for ([value (list wrapped-proc wrapped-box wrapped-hash)])
      (check-equal? (value-type value) "wrapped value")
      (check-equal? (value-preview value) "<wrapped value; inspect explicitly in the console>")
      (check-false (expandable? value))
      (check-equal? (children value 0 10) '())
      (value-preview (vector value (box value))))
    (check-equal? effects 0))
  (test-case "symbol and keyword previews preserve Racket reader escaping"
    (for* ([name (in-list '("silver leaf" "" "." "28" "#f" "seed|pod" "bud\\stem"
                            "(sprout)" "3/4" "λ;落" "a\nb" "#"))]
           [make-name (in-list (list string->symbol string->keyword))])
      (define value (make-name name))
      (define input (open-input-string (value-preview value)))
      (check-equal? (read input) value)
      (check-true (eof-object? (read input))))
    (check-equal? (value-preview 'silver) "silver")
    (check-equal? (value-preview (string->symbol "silver leaf")) "|silver leaf|")
    (check-equal? (value-preview (string->symbol "28")) "|28|")
    (check-equal? (value-preview (string->keyword "silver leaf")) "#:|silver leaf|"))
  (test-case "escaped names remain unambiguous inside containers and syntax"
    (define symbol (string->symbol "blue bud"))
    (define keyword (string->keyword "leaf;stem"))
    (check-equal? (value-preview (list symbol keyword)) "(|blue bud| #:|leaf;stem|)")
    (check-equal? (value-preview (vector symbol keyword)) "#(|blue bud| #:|leaf;stem|)")
    (check-equal? (value-preview (hasheq symbol keyword)) "#hasheq((|blue bud| . #:|leaf;stem|))")
    (check-equal? (value-preview (datum->syntax #f (list symbol keyword)))
                  "#<syntax: (|blue bud| #:|leaf;stem|)>"))
  (test-case "name escaping is bounded and independent of user reader and print handlers"
    (define effects 0)
    (define reader (make-readtable #f #\s 'terminating-macro
                                  (lambda args (set! effects (add1 effects)) 'changed)))
    (parameterize ([current-readtable reader] [read-case-sensitive #f]
                   [read-accept-bar-quote #f] [read-accept-dot #f]
                   [global-port-print-handler (lambda args (set! effects (add1 effects)))])
      (check-equal? (value-preview (string->symbol "silver leaf")) "|silver leaf|")
      (check-equal? (value-preview (string->keyword "silver leaf")) "#:|silver leaf|")
      (check-equal? (value-preview (string->symbol ".")) "|.|")
      (check-equal? (value-preview 'SEED) "SEED"))
    (for* ([name (in-list (list (make-string 50000 #\s) (make-string 50000 #\|)))]
           [make-name (in-list (list string->symbol string->keyword))])
      (define preview (value-preview (make-name name)))
      (check-true (<= (string-length preview) 161))
      (check-true (regexp-match? #rx"…$" preview)))
    (check-equal? effects 0))
  (test-case "unclassified ports reveal direction without assuming safe metadata access"
    ;; apply performs the constructor call outside instrumented application
    ;; syntax, including when this suite itself runs under Debug Test.
    (define input (apply open-input-string '("birch" hidden-input-name)))
    (define output (apply open-output-string '(hidden-output-name)))
    (check-equal? (value-preview input) "#<input-port>")
    (check-equal? (value-preview output) "#<output-port>")
    (check-false (expandable? input))
    (check-equal? (children output 0 10) '())
    (check-equal? (read-string 5 input) "birch")
    (check-equal? (get-output-string output) ""))
  (test-case "delegated ports never invoke name callbacks, printers, or nested wrapped accessors"
    (define effects 0)
    (struct input (port)
      #:property prop:input-port 0
      #:property prop:object-name (lambda (_) (set! effects (add1 effects)) 'changed)
      #:property prop:custom-write (lambda args (set! effects (add1 effects))))
    (struct duplex (in out)
      #:property prop:input-port 0 #:property prop:output-port 1
      #:property prop:object-name (lambda (_) (set! effects (add1 effects)) 'changed))
    (define raw (open-input-string "never read"))
    (define wrapped (chaperone-struct (input raw) input-port
                                     (lambda (_ value) (set! effects (add1 effects)) value)))
    (define delegated (input wrapped))
    (define both (duplex wrapped (open-output-string)))
    (check-equal? (value-preview delegated) "#<input-port>")
    (check-equal? (value-preview both) "#<input-output-port>")
    (check-equal? (value-preview (vector delegated both)) "#(#<input-port> #<input-output-port>)")
    (for ([value (in-list (list wrapped delegated both))])
      (value-preview value)
      (check-false (expandable? value))
      (check-equal? (children value 0 10) '()))
    (check-equal? effects 0)))
