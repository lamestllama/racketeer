(require json racket/async-channel racket/class racket/file racket/gui/base
         racket/list plot file/convertible
         "../../racketdap/worker/plot-window.rkt")

(define (check value message) (unless value (error 'plots message)))
(define (until predicate)
  (define deadline (+ (current-inexact-monotonic-milliseconds) 8000))
  (let loop ()
    (unless (predicate)
      (when (> (current-inexact-monotonic-milliseconds) deadline) (error 'plots "GUI deadline"))
      (sleep/yield 0.02)
      (loop))))
(define (descendants window)
  (cons window (if (is-a? window area-container<%>)
                   (append-map descendants (send window get-children)) '())))
(define (contents frame)
  (define canvas (findf (lambda (widget) (is-a? widget editor-canvas%)) (descendants frame)))
  (values canvas (send (send canvas get-editor) find-first-snip)))
(define (on-window frame thunk)
  (define channel (make-async-channel))
  (parameterize ([current-eventspace (send frame get-eventspace)])
    (queue-callback
     (lambda ()
       (with-handlers ([exn? (lambda (failure) (async-channel-put channel failure))])
         (async-channel-put channel (thunk))))))
  (define result (sync/timeout 8 channel))
  (unless result (error 'plots "Window callback deadline"))
  (when (exn? result) (raise result))
  result)
(define (drag frame x1 y1 x2 y2)
  (define-values (canvas snip) (contents frame))
  (on-window frame
   (lambda ()
     (for ([kind '(left-down motion left-up)] [x (list x1 x2 x2)] [y (list y1 y2 y2)])
       (send canvas on-event
             (new mouse-event% [event-type kind] [x x] [y y]
                  [left-down (not (eq? kind 'left-up))])))
     #t)))
(define (png frame)
  (define-values (_canvas snip) (contents frame))
  (on-window frame (lambda () (convert snip 'png-bytes))))

(define program-custodian (make-custodian))
(define (open plot)
  (parameterize ([current-custodian program-custodian]) (open-plot-window plot)))
(define two (plot (function (lambda (x) (+ (sin x) (* 0.2 x))) -5 5) #:width 400 #:height 300))
(define two-frame (open two))
(define-values (_two-canvas two-view) (contents two-frame))
(check (not (eq? two two-view)) "The view must own its copy")
(define bounds (send two-view get-plot-bounds))
(define before (png two-frame))
(drag two-frame 110 90 290 220)
(until (lambda () (not (equal? bounds (send two-view get-plot-bounds)))))
(until (lambda () (not (equal? before (png two-frame)))))
(check (equal? bounds (send two get-plot-bounds)) "Zoom must not mutate the original plot")
(drag two-frame 150 140 150 140)
(until (lambda () (equal? bounds (send two-view get-plot-bounds))))

(define three (plot3d (surface3d (lambda (x y) (+ (* x x) (* y y))) -2 2 -2 2)
                      #:width 400 #:height 300))
(define three-frame (open three))
(define-values (_three-canvas three-view) (contents three-frame))
(define plane (send three-view plane-vector))
(define three-before (png three-frame))
(drag three-frame 130 110 245 165)
(until (lambda () (not (equal? plane (send three-view plane-vector)))))
(until (lambda () (not (equal? three-before (png three-frame)))))
(check (equal? plane (send three plane-vector)) "Rotation must not mutate the original plot")
(define destination (make-temporary-file "racket-plot-~a.png"))
(dynamic-wind void
 (lambda ()
   (on-window three-frame (lambda () (save-plot-image three-view destination) #t))
   (check (equal? (file->bytes destination) (png three-frame)) "Save must preserve the rotated view"))
 (lambda () (delete-file destination)))

(define overlays 0)
(define overlay (plot-snip (function sin -4 4) #:width 400 #:height 300))
(send overlay set-mouse-event-callback
      (lambda (snip event x y)
        (when (and x y)
          (set! overlays (add1 overlays))
          (send snip set-overlay-renderers (vrule x)))))
(define overlay-frame (open overlay))
(drag overlay-frame 130 110 245 165)
(until (lambda () (positive? overlays)))

(define two-space (send two-frame get-eventspace))
(send two-frame on-close)
(check (eventspace-shutdown? two-space) "Window closure must stop its eventspace")
(check (not (send two-frame is-shown?)) "Closed frame must be hidden")
(check (not (eventspace-shutdown? (send three-frame get-eventspace))) "Other windows must stay live")
(custodian-shutdown-all program-custodian)
(check (eventspace-shutdown? (send three-frame get-eventspace)) "Session shutdown must stop plot eventspaces")
(check (eventspace-shutdown? (send overlay-frame get-eventspace)) "Session shutdown must stop overlay callbacks")
(write-json (hasheq 'checks '("2D zoom" "3D rotation" "independent views" "save current view"
                                        "mouse overlay" "window cleanup" "session cleanup")))
(newline)
(exit 0)
