#lang racket/base
(require racket/gui/base racket/class racket/file json framework)
(define directory (vector-ref (current-command-line-arguments) 0))
(make-directory* directory)
(define (make-fixture name tail #:objects? [objects? #t] #:nested? [nested? #f])
 (define editor (new text%))
 (define projection (open-output-string))
 (define (text value) (send editor insert value) (display value projection))
 (define (object value) (send editor insert value) (display "\uFFFC" projection))
 (text "#lang racket/base\n; λ 😀\n")
 (when objects?
  (define comment (new comment-box:snip%))
  (send (send comment get-editor) insert "(error 'comment \"must not run\")\nsecond comment line λ😀\n")
  (object comment)
  (text "\n(define picture ")
  (object (make-object image-snip% (make-bitmap 4 4)))
  (text ")\n"))
 (when nested?
  (define inner (new text%))
  (send inner insert "(+ 10 20)")
  (text "(define nested ") (object (make-object editor-snip% inner)) (text ")\n"))
 (text tail)
 (define file (build-path directory (string-append name ".wxme")))
 (void (send editor save-file file 'standard))
 (hasheq 'name name 'projection (get-output-string projection)
         'editorCharacters (send editor last-position)))
(define success "(define (answer n)\n\t(+ n 2))\n(displayln (answer 40))\n")
(define fixtures
 (list (make-fixture "text" success #:objects? #f)
       (make-fixture "objects" success)
       (make-fixture "runtime-error" "(define (fail)\n\t(error 'original \"boom λ😀\"))\n(fail)\n")
       (make-fixture "syntax-error" "(define answer missing-name)\n")
       (make-fixture "nested" success #:nested? #t)))
(call-with-output-file (build-path directory "expected.json")
 (lambda (out) (write-json (for/hasheq ([fixture (in-list fixtures)])
                            (values (string->symbol (hash-ref fixture 'name)) (hash-ref fixture 'projection))) out))
 #:exists 'truncate/replace)
(exit)
