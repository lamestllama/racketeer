(require racket/class racket/file framework "../../racketdap/tools/wxme-xml.rkt")
(define directory (vector-ref (current-command-line-arguments) 0))
(make-directory* directory)
(register-xml-boxes!)
(define (box kind mode [text ""])
  (define snip (new xml-box-snip% [kind kind] [mode mode]))
  (send (send snip get-editor) insert text)
  snip)
(define (append! editor content) (send editor insert content (send editor last-position)))
(define (save name editor) (send editor save-file (build-path directory (string-append name ".wxme")) 'standard))
(define empty (new text%))
(for ([kind '("xml" "xml" "racket" "racket")] [mode '(#f #t #f #t)]) (append! empty (box kind mode)))
(void (save "boxes" empty))
(for ([name '("preserve" "eliminate")] [mode '(#f #t)])
  (define program (new text%))
  (append! program "#lang racket/base\n(define base 7)\n(define result ")
  (define xml (box "xml" mode "<root title=\"λ😀\">\n  <first>"))
  (define content (send xml get-editor))
  (append! content (box "racket" #f "(number->string (+ base 2))"))
  (append! content "</first>\n  ")
  (append! content (box "racket" #t "(list '(item () \"α\") '(item () \"😀\"))"))
  (append! content "\n</root>")
  (append! program xml)
  (append! program ")\n(write result)\n(newline)\n")
  (void (save name program)))
(define custom-class (new snip-class%))
(send custom-class set-classname "((lib \"reader.rkt\" \"racketeer-fixture\") (lib \"reader.rkt\" \"racketeer-fixture\"))")
(send (get-the-snip-class-list) add custom-class)
(define custom% (class snip% (super-new) (send this set-snipclass custom-class)
                 (define/override (write stream) (send stream put 42))))
(define (nested name object)
  (define xml (box "xml" #f)) (append! (send xml get-editor) object)
  (define editor (new text%)) (append! editor xml) (void (save name editor)))
(nested "nested-custom" (new custom%))
(define comment (new comment-box:snip%))
(append! (send comment get-editor) "(error 'not-evaluated)\n")
(define xml (box "xml" #f "<script>alert(1)</script>&\n"))
(append! (send xml get-editor) comment)
(define mixed (new text%)) (append! mixed xml) (void (save "mixed" mixed))
(define spoof-class (new snip-class%))
(send spoof-class set-classname "((lib \"reader.rkt\" \"racketeer-fixture\") (lib \"comment.ss\" \"wxme\"))")
(send (get-the-snip-class-list) add spoof-class)
(define spoof (new comment-box:snip%))
(send spoof set-snipclass spoof-class)
(append! (send spoof get-editor) "safe text reader")
(nested "nested-gui-reader" spoof)
(exit)
