#lang racket/gui
(require racket/class racket/file json framework)
(define directory (vector-ref (current-command-line-arguments) 0))
(make-directory* directory)
;; Create original box objects through the documented Insert menu. Contents,
;; copies and saved fixtures use the public editor API.

(parameterize ([current-command-line-arguments #()]) (dynamic-require 'drracket #f))
(define tries 0)
(define timer (new timer% [notify-callback
 (lambda ()
  (set! tries (add1 tries))
  (define frames (filter (lambda (f) (object-method-arity-includes? f 'get-definitions-text 0)) (get-top-level-windows)))
  (when (> tries 100) (error 'fixture "No definitions editor became available."))
  (when (pair? frames)
   (send timer stop)
   (with-handlers ([exn:fail? (lambda (e) (displayln (exn-message e)) (exit 1))])
    (define frame (car frames))
    (define editor (send frame get-definitions-text))
    (send (send frame get-definitions-canvas) focus)
    (define insert-menu (findf (lambda (m) (equal? (send m get-plain-label) "Insert")) (send (send frame get-menu-bar) get-items)))
    (define (make-box label)
     (send editor erase) (send editor set-caret-owner #f 'global)
     (define item (findf (lambda (m) (and (is-a? m labelled-menu-item<%>) (equal? (send m get-plain-label) label))) (send insert-menu get-items)))
     (send item command (new control-event% [event-type 'menu]))
     (define snip (send editor find-first-snip))
     (unless (is-a? snip editor-snip%) (error 'probe "menu did not insert an editor"))
     (send snip copy))
    (define xml (make-box "Insert XML Box"))
    (define racket (make-box "Insert Racket Box"))
    (define splice (make-box "Insert Racket Splice Box"))
    (define (whitespace snip label)
     (define popup (send snip get-menu))
     (define item (findf (lambda (m) (and (is-a? m labelled-menu-item<%>) (equal? (send m get-plain-label) label))) (send popup get-items)))
     (send item command (new control-event% [event-type 'menu])))
    (whitespace xml "Leave whitespace alone")
    (define trimmed (send xml copy))
    (whitespace trimmed "Eliminate whitespace in empty tags")
    (define templates (new text%))
    (for ([snip (list xml trimmed racket splice)]) (send templates insert (send snip copy) (send templates last-position)))
    (send templates save-file (build-path directory "boxes.wxme") 'standard)
    (define results
     (for/list ([template (list xml trimmed)] [name '("preserve" "eliminate")])
      (define program (new text%))
      (send program insert "#lang racket/base\n(define base 7)\n(define result ")
      (define box (send template copy))
      (define content (send box get-editor))
      (send content insert "<root title=\"λ😀\">\n  <first>")
      (define expr (send racket copy))
      (send (send expr get-editor) insert "(number->string (+ base 2))")
      (send content insert expr (send content last-position))
      (send content insert "</first>\n  " (send content last-position))
      (define sequence (send splice copy))
      (send (send sequence get-editor) insert "(list '(item () \"α\") '(item () \"😀\"))")
      (send content insert sequence (send content last-position))
      (send content insert "\n</root>" (send content last-position))
      (send program insert box (send program last-position))
      (send program insert ")\n(write result)\n(newline)\n" (send program last-position))
      (define file (build-path directory (string-append name ".wxme")))
      (send program save-file file 'standard)
      (path->string file)))
    (define custom-class (new snip-class%))
    (send custom-class set-classname "((lib \"reader.rkt\" \"racketeer-fixture\") (lib \"reader.rkt\" \"racketeer-fixture\"))")
    (send (get-the-snip-class-list) add custom-class)
    (define custom% (class snip% (super-new) (send this set-snipclass custom-class)
                     (define/override (write stream) (send stream put 42))))
    (define blocked (send xml copy))
    (send (send blocked get-editor) insert (new custom%))
    (define blocked-editor (new text%)) (send blocked-editor insert blocked)
    (send blocked-editor save-file (build-path directory "nested-custom.wxme") 'standard)
    (define comment (new comment-box:snip%))
    (send (send comment get-editor) insert "(error 'not-evaluated)\n")
    (define mixed (send xml copy))
    (send (send mixed get-editor) insert "<script>alert(1)</script>&\n")
    (send (send mixed get-editor) insert comment (send (send mixed get-editor) last-position))
    (define mixed-editor (new text%)) (send mixed-editor insert mixed)
    (send mixed-editor save-file (build-path directory "mixed.wxme") 'standard)
    (write-json results) (newline) (exit))))]))
(send timer start 100)
