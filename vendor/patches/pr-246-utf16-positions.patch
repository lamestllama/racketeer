From b23ac287a48430dc263b07099ab153a6c8131d1e Mon Sep 17 00:00:00 2001
From: Eric Parsonage <eric@eparsonage.com>
Date: Sun, 1 Nov 2026 16:10:18 +1030
Subject: [PATCH 2/5] Take the hover source column from the line start

The hover needs a character column, which is the offset from the start
of its line. Subtract the line start instead of converting the position
to a line and column.
---
 doclib/doc.rkt | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/doclib/doc.rkt b/doclib/doc.rkt
index a70da9b..c87ff54 100644
--- a/doclib/doc.rkt
+++ b/doclib/doc.rkt
@@ -622,7 +622,8 @@
 ;; continuation lines inside multiline literals.
 (define (hover-source-lines doc start text)
   ;; Characters, not LSP columns: the column becomes leading spaces.
-  (define column (cadr (send (Doc-text doc) pos->line/char start)))
+  (define doc-text (Doc-text doc))
+  (define column (- start (send doc-text line-start-pos (send doc-text at-line start))))
   (string-split (string-append (make-string column #\space) text)
                 "\n" #:trim? #f))
 
