From 5a8f67cae1043b15efb3c3bae1b02e76d89ea0c6 Mon Sep 17 00:00:00 2001
From: Eric Parsonage <eric@eparsonage.com>
Date: Sun, 1 Nov 2026 23:05:49 +1030
Subject: [PATCH 4/5] Take diagnostic columns from positions and scan lines for
 UTF-16

Racket source-location diagnostics now start at the one-based character
position. The reader's column counts a tab up to the next multiple of 8,
so it is not an LSP column on tab-indented lines.

The fixw and DrRacket formatters measure the end of each line edit in
UTF-16 code units, not characters.

pos->line/char and line/char->pos scan their line on each call instead
of caching the offsets of astral characters, so reading a position no
longer changes the editor while SafeDoc holds only its read lock.
---
 common/interfaces.rkt                    | 12 +++++
 doclib/formatter/drracket.rkt            | 13 ++---
 doclib/formatter/fixw.rkt                |  2 +-
 doclib/service/diagnostic.rkt            | 10 ++--
 doclib/textbuffer/editor-rope.rkt        | 65 ++++++++++--------------
 tests/fixtures/formatter-hook-reader.rkt |  4 +-
 tests/lib/doc-test.rkt                   | 15 ++++++
 tests/lib/drracket-formatter-test.rkt    | 15 ++++++
 tests/lib/editor-test.rkt                |  2 +
 tests/lib/formatting-backends-test.rkt   | 12 +++++
 10 files changed, 98 insertions(+), 52 deletions(-)

diff --git a/common/interfaces.rkt b/common/interfaces.rkt
index 33241bb..d1900ff 100644
--- a/common/interfaces.rkt
+++ b/common/interfaces.rkt
@@ -67,12 +67,24 @@
          *semantic-token-types*
          *semantic-token-modifiers*
          abs-pos->Pos
+         char-utf16-length
+         string-utf16-length
          (json-type-out Resyntax-Result))
 
 (define-json-struct Pos
   [line exact-nonnegative-integer?]
   [char exact-nonnegative-integer? #:json character])
 
