From 913dabb35270e8ed62c12cc170dc4441ca8d3119 Mon Sep 17 00:00:00 2001
From: Eric Parsonage <eric@eparsonage.com>
Date: Sun, 1 Nov 2026 09:31:40 +1030
Subject: [PATCH] Count LSP columns in UTF-16 code units

LSP positions count UTF-16 code units within a line, while the editor
buffer and Racket syntax positions count characters. After a character
outside the Basic Multilingual Plane, such as an emoji, each column on
the line was off by one for every such character before it, so hover,
definition, edits, semantic tokens and diagnostics used the wrong
column.

Convert at the editor boundary. lsp-position->pos and pos->lsp-position
count the astral characters before a column on its line. Document
positions, workspace locations, semantic-token lengths and diagnostic
ranges use them. Hover source indentation keeps character columns.
---
 common/interfaces.rkt             |  2 +-
 doclib/doc-trace.rkt              |  2 +-
 doclib/doc.rkt                    |  7 +++--
 doclib/service/diagnostic.rkt     | 12 ++++++--
 doclib/textbuffer/editor-rope.rkt | 50 +++++++++++++++++++++++++++++--
 lsp/semantic-token-lsp.rkt        |  3 +-
 tests/lib/doc-test.rkt            | 39 ++++++++++++++++++++++++
 tests/lib/editor-test.rkt         | 25 ++++++++++++++++
 8 files changed, 128 insertions(+), 12 deletions(-)

diff --git a/common/interfaces.rkt b/common/interfaces.rkt
index 33241bb..00aaac2 100644
--- a/common/interfaces.rkt
+++ b/common/interfaces.rkt
@@ -364,7 +364,7 @@
   (list SemanticTokenModifier-definition))
 
 (define (abs-pos->Pos editor pos)
-  (match-define (list line char) (send editor pos->line/char pos))
+  (match-define (list line char) (send editor pos->lsp-position pos))
   (Pos #:line line #:char char))
 
 ;; Resyntax-Result: result of a resyntax refactoring suggestion
diff --git a/doclib/doc-trace.rkt b/doclib/doc-trace.rkt
index 03ec53f..a4ee4de 100644
--- a/doclib/doc-trace.rkt
+++ b/doclib/doc-trace.rkt
@@ -121,7 +121,7 @@
            (let ()
              (define (abs->pos pos)
                (match-define (list line char)
-                 (send doc-text pos->line/char pos))
+                 (send doc-text pos->lsp-position pos))
                (Pos line char))
 
              (define (range->location range)
diff --git a/doclib/doc.rkt b/doclib/doc.rkt
index 7fe59bc..a70da9b 100644
--- a/doclib/doc.rkt
+++ b/doclib/doc.rkt
@@ -294,11 +294,11 @@
 
 (define/contract (doc-pos->abs-pos doc pos)
   (-> Doc? Pos? exact-nonnegative-integer?)
-  (send (Doc-text doc) line/char->pos (Pos-line pos) (Pos-char pos)))
+  (send (Doc-text doc) lsp-position->pos (Pos-line pos) (Pos-char pos)))
 
 (define/contract (doc-abs-pos->pos doc pos)
   (-> Doc? exact-nonnegative-integer? Pos?)
-  (match-define (list line char) (send (Doc-text doc) pos->line/char pos))
+  (match-define (list line char) (send (Doc-text doc) pos->lsp-position pos))
   (Pos line char))
 
 (define/contract (doc-line-start-abs-pos doc line)
@@ -621,7 +621,8 @@
 ;; whitespace character. Dedenting is display-only and also applies to
 ;; continuation lines inside multiline literals.
 (define (hover-source-lines doc start text)
-  (define column (Pos-char (doc-abs-pos->pos doc start)))
+  ;; Characters, not LSP columns: the column becomes leading spaces.
+  (define column (cadr (send (Doc-text doc) pos->line/char start)))
   (string-split (string-append (make-string column #\space) text)
                 "\n" #:trim? #f))
 
diff --git a/doclib/service/diagnostic.rkt b/doclib/service/diagnostic.rkt
index e0022ad..ac6da8e 100644
--- a/doclib/service/diagnostic.rkt
+++ b/doclib/service/diagnostic.rkt
@@ -199,11 +199,17 @@
      (define srclocs ((exn:srclocs-accessor exn) exn))
      (for/list ([sl (in-list srclocs)])
        (match-define (srcloc src line col pos span) sl)
-       (if (and (number? line) (number? col) (number? span))
+       ;; Source location columns count characters. Convert through the
+       ;; character offset so the range uses LSP columns.
+       (define start
+         (and (exact-positive-integer? line) (exact-nonnegative-integer? col)
+              (+ (send doc-text line-start-pos (sub1 line)) col)))
+       (if (and start (exact-nonnegative-integer? span)
+                (<= (+ start span) (send doc-text end-pos)))
            (Diagnostic #:range (nonempty-diagnostic-range
                                  doc-text
-                                 (Range #:start (Pos #:line (sub1 line) #:char col)
-                                        #:end (Pos #:line (sub1 line) #:char (+ col span))))
+                                 (Range #:start (abs-pos->Pos doc-text start)
+                                        #:end (abs-pos->Pos doc-text (+ start span))))
                        #:severity DiagnosticSeverity-Error
                        #:source "Racket"
                        #:message diagnostic-msg)
diff --git a/doclib/textbuffer/editor-rope.rkt b/doclib/textbuffer/editor-rope.rkt
index c5f2f76..5751f8b 100644
--- a/doclib/textbuffer/editor-rope.rkt
+++ b/doclib/textbuffer/editor-rope.rkt
@@ -11,9 +11,13 @@
     (init [initial-buffer (rope-from-string "")])
 
     (define rope initial-buffer)
+    ;; line -> character offsets of characters outside the Basic Multilingual
+    ;; Plane on that line. Cleared on every change to the text.
+    (define astral-lines (make-hash))
 
     (define/private (replace-range str start-pos end-pos)
-      (set! rope (rope-replace rope start-pos end-pos str)))
+      (set! rope (rope-replace rope start-pos end-pos str))
+      (hash-clear! astral-lines))
 
     (define/private (line-count)
       (add1 (rope-offset->line rope (rope-chars rope))))
@@ -44,10 +48,12 @@
 
     ;; remove all content
     (define/public (erase)
-      (set! rope (rope-from-string "")))
+      (set! rope (rope-from-string ""))
+      (hash-clear! astral-lines))
 
     (define/public (load-file path)
-      (set! rope (rope-from-string (file->string path))))
+      (set! rope (rope-from-string (file->string path)))
+      (hash-clear! astral-lines))
 
     ;; return current content in editor as string
     (define/public (get-text [start 0] [end 'eof])
@@ -66,6 +72,44 @@
       (list line
             (- pos (send this line-start-pos line))))
 
+    ;; LSP positions count UTF-16 code units within a line, while the rope and
+    ;; Racket syntax positions count characters. A character outside the Basic
+    ;; Multilingual Plane is one character and two UTF-16 code units.
+    (define/private (astral-offsets line)
+      (hash-ref! astral-lines line
+                 (lambda ()
+                   (list->vector
+                     (for/list ([character (in-string (send this get-line line))]
+                                [offset (in-naturals)]
+                                #:when (> (char->integer character) #xffff))
+                       offset)))))
+
+    ;; Number of astral characters that start before `column`, counted in
+    ;; UTF-16 code units when `utf16?` and in characters otherwise.
+    (define/private (astral-count-before offsets column utf16?)
+      (let loop ([low 0]
+                 [high (vector-length offsets)])
+        (if (= low high)
+            low
+            (let* ([middle (quotient (+ low high) 2)]
+                   [start (+ (vector-ref offsets middle) (if utf16? middle 0))])
+              (if (< start column)
+                  (loop (add1 middle) high)
+                  (loop low middle))))))
+
+    ;; A column past the end of the line means the end of the line, and a
+    ;; column inside a surrogate pair means the start of its character.
+    (define/public (lsp-position->pos line char)
+      (define start (line-start-pos/raw line))
+      (define offsets (astral-offsets line))
+      (min (send this line-end-pos line)
+           (+ start (- char (astral-count-before offsets char #t)))))
+
+    (define/public (pos->lsp-position pos)
+      (define line (rope-offset->line rope pos))
+      (define column (- pos (send this line-start-pos line)))
+      (list line (+ column (astral-count-before (astral-offsets line) column #f))))
+
     (define/public (line-start-pos line)
       (rope-line-start-offset rope line))
 
diff --git a/lsp/semantic-token-lsp.rkt b/lsp/semantic-token-lsp.rkt
index 4291987..1fa9d9f 100644
--- a/lsp/semantic-token-lsp.rkt
+++ b/lsp/semantic-token-lsp.rkt
@@ -51,7 +51,8 @@
     (if (= line prev-line)
         (- char prev-char)
         char))
-  (define len (- (SemanticToken-end token) (SemanticToken-start token)))
+  ;; Tokens are split by line, so both ends are on the same line.
+  (define len (- (Pos-char (abs-pos->pos (SemanticToken-end token))) char))
   (define type (token-type-encoding token))
   (define modifier (token-modifier-encoding token))
   (values delta-line delta-start len type modifier))
diff --git a/tests/lib/doc-test.rkt b/tests/lib/doc-test.rkt
index cbac6d9..b48467c 100644
--- a/tests/lib/doc-test.rkt
+++ b/tests/lib/doc-test.rkt
@@ -14,6 +14,7 @@
            "../../doclib/formatter/fmt.rkt"
            "../../common/interfaces.rkt"
            "../../common/path-util.rkt"
+           "../../lsp/semantic-token-lsp.rkt"
            racket/class
            racket/file
            drracket/check-syntax
@@ -29,6 +30,14 @@
     (check-equal? (doc-range-tokens d (Range (Pos 0 0) (Pos 0 100))) bounded)
     (check-equal? (doc-range-tokens d (Range (Pos 3 0) (Pos 4 0))) '()))
 
+  (test-case
+    "Semantic tokens count UTF-16 code units after and within astral characters"
+    ;; U+1F600 is one character and two UTF-16 code units.
+    (define d (make-doc "file:///utf16-tokens.rkt" "\U0001F600 #; (\U0001F600)"))
+    (define tokens (doc-range-tokens d (Range (Pos 0 0) (Pos 0 10))))
+    (check-equal? (take (encode-semantic-tokens (lambda (pos) (doc-abs-pos->pos d pos)) tokens) 3)
+                  '(0 3 7)))
+
   (test-case
     "Document creation and basic accessors"
     (define d (make-doc "file:///test.rkt" "hello world"))
@@ -580,6 +589,21 @@
     (check-not-false diag)
     (check-equal? (Diagnostic-source diag) "Racket"))
 
+  (test-case
+    "Document diagnostics count UTF-16 code units after astral characters"
+    ;; U+1F600 is one character and two UTF-16 code units, so the unbound
+    ;; identifier starts at character 4 and at LSP column 5.
+    (define text "#lang racket/base\n\"\U0001F600\" unbound-name\n")
+    (define diags
+      (check-syntax-diagnostics (uri->source "file:///tmp/utf16-diagnostic-test.rkt")
+                                text))
+    (define diag
+      (for/first ([diag (in-list diags)]
+                  #:when (regexp-match? #rx"unbound-name" (Diagnostic-message diag)))
+        diag))
+    (check-not-false diag)
+    (check-equal? (Diagnostic-range diag) (Range (Pos 1 5) (Pos 1 17))))
+
   (test-case
     "Document diagnostics accept wrapped #lang headers"
     (define at-exp-diags
@@ -1219,6 +1243,21 @@ END
     (check-equal? (Location-range result)
                   (Range (Pos 1 8) (Pos 1 9))))
 
+  (test-case
+    "Document positions count UTF-16 code units after astral characters"
+    ;; U+1F600 is one character and two UTF-16 code units, so `x` in
+    ;; `(define x 1)` is at character 12 and at LSP column 13, and its use at
+    ;; character 17 is at LSP column 18.
+    (define uri "file:///tmp/doc-utf16-test.rkt")
+    (define d (make-doc uri "#lang racket\n\"\U0001F600\" (define x 1) x\n"))
+    (check-equal? (doc-pos->abs-pos d (Pos 1 13)) 25)
+    (check-equal? (doc-abs-pos->pos d 25) (Pos 1 13))
+    (doc-expand! d)
+    (check-equal? (Location-range (doc-definition d uri (Pos 1 18)))
+                  (Range (Pos 1 13) (Pos 1 14)))
+    (doc-apply-edit! d (Range (Pos 1 18) (Pos 1 19)) "y")
+    (check-equal? (doc-get-text d) "#lang racket\n\"\U0001F600\" (define x 1) y\n"))
+
   (test-case
     "doc-definition for imported define"
     (define-values (d uri) (make-expanded-doc))
diff --git a/tests/lib/editor-test.rkt b/tests/lib/editor-test.rkt
index f5dda6d..c8db202 100644
--- a/tests/lib/editor-test.rkt
+++ b/tests/lib/editor-test.rkt
@@ -226,6 +226,31 @@
     (check-equal? (send editor line-end-pos 2) eof)
     (check-equal? (send editor at-line eof) 1))
 
+  (test-case "editor converts LSP columns, which count UTF-16 code units"
+    ;; U+1F600 is one character and two UTF-16 code units.
+    (define editor (make-editor "a\U0001F600b\n\U0001F600\U0001F600c\n"))
+
+    (for ([lsp-column (in-list '(0 1 3 4))]
+          [pos (in-list '(0 1 2 3))])
+      (check-equal? (send editor lsp-position->pos 0 lsp-column) pos)
+      (check-equal? (send editor pos->lsp-position pos) (list 0 lsp-column)))
+    (for ([lsp-column (in-list '(0 2 4 5))]
+          [pos (in-list '(4 5 6 7))])
+      (check-equal? (send editor lsp-position->pos 1 lsp-column) pos)
+      (check-equal? (send editor pos->lsp-position pos) (list 1 lsp-column)))
+    ;; A column inside a surrogate pair names the start of its character.
+    (check-equal? (send editor lsp-position->pos 0 2) 1)
+    ;; A column past the end of a line means the end of that line.
+    (check-equal? (send editor lsp-position->pos 0 10) 3)
+    ;; Character columns are unchanged.
+    (check-equal? (send editor line/char->pos 1 2) 6)
+    (check-equal? (send editor pos->line/char 6) '(1 2))
+
+    (send editor replace "x" 1 2)
+    (check-equal? (send editor get-line 0) "axb")
+    (check-equal? (send editor lsp-position->pos 0 2) 2)
+    (check-equal? (send editor pos->lsp-position 3) '(0 3)))
+
   (test-case "editor copy keeps an immutable snapshot"
     (define editor (make-editor "abc\n"))
 
