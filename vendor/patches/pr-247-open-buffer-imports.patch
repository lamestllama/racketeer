diff --git a/common/source-snapshot.rkt b/common/source-snapshot.rkt
new file mode 100644
index 0000000..c8e2d7b
--- /dev/null
+++ b/common/source-snapshot.rkt
@@ -0,0 +1,63 @@
+#lang racket/base
+
+;; Module loading for one analysis that reads open editor buffers instead of
+;; disk files. Project dependencies are read from source so compiled
+;; intermediates cannot retain an older macro expansion. Libraries outside the
+;; project keep their ordinary compiled loading policy.
+(require racket/list
+         racket/path
+         setup/dirs
+         syntax/modcode)
+
+(provide call-with-source-snapshot)
+
+;; sources: complete normalized path -> buffer text, or #f when two buffers
+;;   claim the same path.
+;; source?: whether a file outside `sources` loads from source.
+;; on-load: receives each module file the expansion loads.
+;; Installed collections keep compiled loading even below a project folder,
+;; for example when a workspace folder contains the Racket installation.
+(define (installed-library? file)
+  (define parts (explode-path file))
+  (for/or ([dir (in-list (filter values (list* (find-collects-dir) (find-pkgs-dir)
+                                               (find-user-collects-dir) (find-user-pkgs-dir)
+                                               (current-library-collection-paths))))])
+    (define root (explode-path (simplify-path (path->complete-path dir) #f)))
+    (and (<= (length root) (length parts)) (equal? root (take parts (length root))))))
+
+(define (call-with-source-snapshot sources proc
+                                   #:source? [source? (lambda (_) #f)]
+                                   #:on-load [on-load void])
+  (define ordinary-load (current-load/use-compiled))
+  (define ordinary-open (moddep-current-open-input-file))
+  (define (load-snapshot file expected)
+    (define requested (simple-form-path file))
+    (define legacy (path-replace-extension requested #".ss"))
+    (define full
+      (if (and expected (equal? (path-get-extension requested) #".rkt")
+               (not (hash-has-key? sources requested)) (not (file-exists? requested))
+               (or (hash-has-key? sources legacy) (file-exists? legacy)))
+          legacy requested))
+    (when expected (on-load full))
+    (cond
+      [(and expected (or (hash-has-key? sources full)
+                         (and (file-exists? full) (source? full) (not (installed-library? full)))))
+       ;; A #f-headed request permits independent compiled loading only. Let
+       ;; the resolver request the enclosing source module instead.
+       (unless (and (pair? expected) (not (car expected)))
+         (parameterize ([current-load-relative-directory (path-only full)]
+                        [current-module-declare-source full])
+           (eval (get-module-code full #:sub-path '() #:rkt-try-ss? #f
+                                  #:choose (lambda _ 'src)))))]
+      [else (ordinary-load file expected)]))
+  (parameterize ([current-load/use-compiled load-snapshot]
+                 [moddep-current-open-input-file
+                  (lambda (file)
+                    (define full (simple-form-path file))
+                    (cond
+                      [(hash-has-key? sources full)
+                       (define text (hash-ref sources full))
+                       (unless text (error 'source-snapshot "conflicting buffers for ~a" full))
+                       (open-input-string text full)]
+                      [else (ordinary-open file)]))])
+    (proc)))
diff --git a/lsp/analysis-lifecycle.md b/lsp/analysis-lifecycle.md
index 719f3c9..0b3cba3 100644
--- a/lsp/analysis-lifecycle.md
+++ b/lsp/analysis-lifecycle.md
@@ -119,6 +119,29 @@ The controller receives its publication workspace through `#:workspace`.
 The default remains the process's `current-workspace`, also used by existing
 workspace requests. Injecting a different publication workspace alone does not
 create an isolated LSP session; the request layer must use that same workspace.
+Its folders are also project roots for imported modules, as described below.
+
+## Imports from open buffers
+
+Each analysis attempt carries an `Analysis-Context`: an immutable table of the
+open file buffers taken when the attempt is requested, the project roots, and a
+table the worker fills with every module file the expansion loads. An import
+of a file with an open buffer reads that buffer, unsaved edits included. Two
+buffers for one path make that import an error rather than a choice between
+them. Modules below a workspace folder or the directory of an open buffer load
+from source, so a compiled file written before an unsaved or saved change
+cannot keep an older macro expansion. Libraries in installed collections keep
+ordinary compiled loading, even below a project root. Analysis never writes
+compiled files.
+
+The controller keeps, for each open buffer, the module files its accepted
+analysis loaded. Opening, editing or closing a buffer starts a new attempt for
+every other open buffer whose accepted analysis, or whose running attempt, has
+loaded that file. The new attempt supersedes outstanding work for the same
+revision and clears exact availability first, so queries wait for facts from
+the new text. Acceptance compares the buffer texts an analysis read with the
+current buffers; a product that read a buffer since changed, opened or closed
+is not installed, and another attempt starts in its place.
 
 ## Available results and fresh completion
 
