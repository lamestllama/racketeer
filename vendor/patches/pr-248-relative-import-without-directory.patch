From 2e29f5251cb986894cfaaf83ced6802f22a393f9 Mon Sep 17 00:00:00 2001
From: Eric Parsonage <eric@eparsonage.com>
Date: Sun, 1 Nov 2026 09:44:38 +1030
Subject: [PATCH 1/2] Refuse relative imports in documents without a directory

A document with no analysis directory, such as an untitled buffer, has
no file for a relative module path to resolve against. The module name
resolver then used the server's working directory, so a relative
require could load an unrelated file from there or report a missing
file in that directory.

Refuse such an import with a syntax error located at the module path.
Collection imports, absolute file paths and documents with a directory
are unaffected.
---
 doclib/check-syntax.rkt | 33 +++++++++++++++++++++++++++++++++
 tests/lib/doc-test.rkt  | 23 +++++++++++++++++++++++
 2 files changed, 56 insertions(+)

diff --git a/doclib/check-syntax.rkt b/doclib/check-syntax.rkt
index edabd35..c7f6fd6 100644
--- a/doclib/check-syntax.rkt
+++ b/doclib/check-syntax.rkt
@@ -3,6 +3,7 @@
          racket/class
          racket/contract
          racket/logging
+         racket/match
          syntax/modread
          racket/path
          racket/port
@@ -49,6 +50,34 @@
             (check-false (source-analysis-directory (uri->source uri))))))
       (lambda () (delete-directory/files root)))))
 
+(define (relative-module-path? module)
+  (match module
+    [(? path-string?) (relative-path? module)]
+    [(list 'file (? path-string? file)) (relative-path? file)]
+    [(list* 'submod (and parent (not (or "." ".."))) _) (relative-module-path? parent)]
+    [_ #f]))
+
+;; The module name resolver resolves a relative module path against the module
+;; that requires it. A document without an analysis directory has no file to
+;; resolve against, so the resolver would use the server's working directory.
+;; Refuse such an import instead. Modules loaded from files are unaffected.
+(define (refuse-unbased-relative-imports resolve)
+  (case-lambda
+    [(name namespace) (resolve name namespace)]
+    [(module relative-to stx load?)
+     (define base
+       (and relative-to
+            (let ([name (resolved-module-path-name relative-to)])
+              (if (pair? name) (car name) name))))
+     (when (and (relative-module-path? module)
+                (not (path? base))
+                (not (current-load-relative-directory)))
+       (raise-syntax-error
+         #f
+         "Relative imports need a save location. Save this document to import files relative to it."
+         stx))
+     (resolve module relative-to stx load?)]))
+
 ;; TODO: cache the namespace with some strategy
 (define (expand-source source in collector #:expand? [expand? #t])
   (define src-dir (source-analysis-directory source))
@@ -58,6 +87,10 @@
   (port-count-lines! in)
 
   (parameterize ([current-load-relative-directory src-dir]
+                 [current-module-name-resolver
+                  (if src-dir
+                      (current-module-name-resolver)
+                      (refuse-unbased-relative-imports (current-module-name-resolver)))]
                  [current-namespace ns]
                  [current-annotations collector])
     (define stx
diff --git a/tests/lib/doc-test.rkt b/tests/lib/doc-test.rkt
index cbac6d9..d240d1e 100644
--- a/tests/lib/doc-test.rkt
+++ b/tests/lib/doc-test.rkt
@@ -533,6 +533,29 @@
                                 text))
     (check-equal? (language-header-diagnostics diags) '()))
 
+  (test-case
+    "Relative imports in a document without a directory are refused, not resolved from the working directory"
+    (define root (make-temporary-file "unbased-import~a" 'directory))
+    (dynamic-wind
+      void
+      (lambda ()
+        (display-to-file "#lang racket/base\n(provide value)\n(define value 1)\n"
+                         (build-path root "dependency.rkt"))
+        (parameterize ([current-directory root])
+          (define message
+            "Relative imports need a save location. Save this document to import files relative to it.")
+          (define (refusals text)
+            (for/list ([diag (in-list (check-syntax-diagnostics (uri->source "untitled:Untitled-1") text))]
+                       #:when (string-contains? (Diagnostic-message diag) message))
+              (Diagnostic-range diag)))
+          (check-equal? (refusals "#lang racket/base\n(require \"dependency.rkt\")\nvalue\n")
+                        (list (Range (Pos 1 9) (Pos 1 25))))
+          (check-equal? (refusals "#lang racket/base\n(require (submod \"dependency.rkt\" x))\n")
+                        (list (Range (Pos 1 9) (Pos 1 36))))
+          (check-equal? (refusals "#lang racket/base\n(require racket/list (file \"/no/such/file.rkt\"))\n")
+                        '())))
+      (lambda () (delete-directory/files root))))
+
   (test-case
     "Document diagnostics simplify missing collection messages"
     (define text "#lang racke\n")
-- 
2.43.0


From 53e8dcd249d8f0120aa5a0fe8bbc397009f0500c Mon Sep 17 00:00:00 2001
From: Eric Parsonage <eric@eparsonage.com>
Date: Sun, 1 Nov 2026 10:30:02 +1030
Subject: [PATCH 2/2] Report the relative import refusal when the resolver has
 no syntax

Racket 8.0 and earlier pass no syntax for a require to the module name
resolver. The refusal then raised a syntax error with no source
location, which produced no diagnostic. Give it the document as its
source in that case, so it is reported on the first line.
---
 doclib/check-syntax.rkt |  9 ++++++---
 tests/lib/doc-test.rkt  | 20 ++++++++++++++++++--
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/doclib/check-syntax.rkt b/doclib/check-syntax.rkt
index c7f6fd6..97aff98 100644
--- a/doclib/check-syntax.rkt
+++ b/doclib/check-syntax.rkt
@@ -61,7 +61,9 @@
 ;; that requires it. A document without an analysis directory has no file to
 ;; resolve against, so the resolver would use the server's working directory.
 ;; Refuse such an import instead. Modules loaded from files are unaffected.
-(define (refuse-unbased-relative-imports resolve)
+;; Older Racket versions pass no syntax for the require, so the refusal then
+;; names only the document.
+(define (refuse-unbased-relative-imports resolve document)
   (case-lambda
     [(name namespace) (resolve name namespace)]
     [(module relative-to stx load?)
@@ -75,7 +77,7 @@
        (raise-syntax-error
          #f
          "Relative imports need a save location. Save this document to import files relative to it."
-         stx))
+         (or stx (datum->syntax #f module (vector document #f #f #f #f)))))
      (resolve module relative-to stx load?)]))
 
 ;; TODO: cache the namespace with some strategy
@@ -90,7 +92,8 @@
                  [current-module-name-resolver
                   (if src-dir
                       (current-module-name-resolver)
-                      (refuse-unbased-relative-imports (current-module-name-resolver)))]
+                      (refuse-unbased-relative-imports (current-module-name-resolver)
+                                                       (source-syntax-source source)))]
                  [current-namespace ns]
                  [current-annotations collector])
     (define stx
diff --git a/tests/lib/doc-test.rkt b/tests/lib/doc-test.rkt
index d240d1e..28d9126 100644
--- a/tests/lib/doc-test.rkt
+++ b/tests/lib/doc-test.rkt
@@ -544,14 +544,30 @@
         (parameterize ([current-directory root])
           (define message
             "Relative imports need a save location. Save this document to import files relative to it.")
+          ;; Older Racket versions pass no syntax for a require to the module
+          ;; name resolver, so the refusal is reported on the first line.
+          (define resolver-receives-syntax?
+            (let ([resolve (current-module-name-resolver)]
+                  [received #f])
+              (parameterize ([current-namespace (make-base-namespace)]
+                             [current-module-name-resolver
+                              (case-lambda
+                                [(name namespace) (resolve name namespace)]
+                                [(module relative-to stx load?)
+                                 (when (equal? module "dependency.rkt") (set! received (syntax? stx)))
+                                 (resolve module relative-to stx load?)])])
+                (expand '(module probe racket/base (require "dependency.rkt"))))
+              received))
+          (define (located range)
+            (if resolver-receives-syntax? range (Range (Pos 0 0) (Pos 0 17))))
           (define (refusals text)
             (for/list ([diag (in-list (check-syntax-diagnostics (uri->source "untitled:Untitled-1") text))]
                        #:when (string-contains? (Diagnostic-message diag) message))
               (Diagnostic-range diag)))
           (check-equal? (refusals "#lang racket/base\n(require \"dependency.rkt\")\nvalue\n")
-                        (list (Range (Pos 1 9) (Pos 1 25))))
+                        (list (located (Range (Pos 1 9) (Pos 1 25)))))
           (check-equal? (refusals "#lang racket/base\n(require (submod \"dependency.rkt\" x))\n")
-                        (list (Range (Pos 1 9) (Pos 1 36))))
+                        (list (located (Range (Pos 1 9) (Pos 1 36)))))
           (check-equal? (refusals "#lang racket/base\n(require racket/list (file \"/no/such/file.rkt\"))\n")
                         '())))
       (lambda () (delete-directory/files root))))
-- 
