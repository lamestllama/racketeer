+                   (for/set ([owner (in-set (caddr family))]) (hash-ref forward owner owner))))
+           (list->set (hash-ref after 'families)))
+    (refuse))
+  forward)
+
+;; Check token/alias relations and every confirmed source name through the correspondence.
+(define (validate-rename-proposal before after ranges name correspondence before-relations after-relations
+                                  [shift (rename-offset ranges name)])
+  (define expected
+    (for/set ([entry (in-set (hash-ref before 'names))])
+      (match-define (list range phase space role owner) entry)
+      (list (cons (shift (car range)) (shift (cdr range))) phase space role
