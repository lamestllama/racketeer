+                      (hash-ref fact 'phase 0) (hash-ref fact 'space #f)))
+    (define owner (or (bound-owner fact) (cons 'local key)))
+    (free-id-table-set! (table fact) (hash-ref fact 'identifier) owner)
+    (hash-set! binders key (list owner (hash-ref fact 'range) (syntax-e (hash-ref fact 'identifier)))))
+  (for ([fact (in-list (hash-ref facts 'names))]
+        #:when (rename-module-binding fact))
+    (unless (free-id-table-ref (table fact) (hash-ref fact 'identifier) #f)
+      (free-id-table-set! (table fact) (hash-ref fact 'identifier) (rename-module-binding fact))))
