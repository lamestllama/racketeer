+      [(list (and kind (or 'for-meta 'for-space 'just-meta 'just-space)) shift _ ...)
+       (list kind shift (map (lambda (p) (import-spec p (if (eq? kind 'for-meta) (and phase shift (+ phase shift)) phase)))
