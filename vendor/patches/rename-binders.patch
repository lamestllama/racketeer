+  (unless (and (equal? expected (hash-ref after 'names))
+               (equal? (component-counts expected-components) (component-counts (hash-ref after 'components)))
+               (equal? expected-occurrences (hash-ref after 'occurrences))
+               (= (length old-structure) (length new-structure))
+               (for/and ([old (in-list old-structure)] [new (in-list new-structure)])
