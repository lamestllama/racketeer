+    (match* (old new)
+      [((vector (and internal (vector spelling owner range)) external)
+        (vector (and next-internal (vector next-spelling next _)) next-external))
+       (and (equal? (hash-ref correspondence owner owner) next)
+            (or (same-name? internal next-internal)
+                (set-member? (hash-ref binder-spellings owner (set)) (cons spelling next-spelling)))
+            (same-name? external next-external))]
