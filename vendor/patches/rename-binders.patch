+        (for ([owner (in-set members)] #:unless (set-member? selected owner))
+          (set-add! selected owner)
+          (set! next (cons owner next))))
+      (loop next)))
+  selected)
+
+;; Check every binder; only edited owners may change identity, injectively.
+(define (rename-correspondence before after ranges name [shift (rename-offset ranges name)])
