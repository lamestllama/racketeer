+    (define-values (id phase) (values (hash-ref fact 'identifier) (hash-ref fact 'phase 0)))
+    (define binding (identifier-binding id phase))
+    (define scoped
+      (hash-set* fact 'space (hash-ref fact 'space (lambda () (and (list? binding) (pair? (list-ref binding 6)) (cdr (list-ref binding 6)))))
