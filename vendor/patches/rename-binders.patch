+;; Index explicit family edges once.
+(define (selected-owners before ranges)
+  (define edits (edit-index ranges))
+  (define edges (make-hash))
+  (define-values (selected visited) (values (mutable-set) (mutable-seteq)))
+  (for ([entry (in-hash-values (hash-ref before 'binders))])
+    (when (edited-location? (cadr entry) edits) (set-add! selected (car entry))))
+  (for ([component (in-list (hash-ref before 'components))]
+        #:when (edited-location? (car component) edits))
+    (unless (caddr component) (refuse))
+    (set-add! selected (cadr component)))
+  (for ([members (in-list (map caddr (hash-ref before 'families)))])
+    (for ([owner (in-set members)]) (hash-update! edges owner (lambda (sets) (cons members sets)) '())))
