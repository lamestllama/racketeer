+++ b/doclib/rename-validation.rkt
@@ -0,0 +1,351 @@
+#lang racket/base
+;; Copyright (c) 2026 Eric Parsonage
+;; SPDX-License-Identifier: Apache-2.0 OR MIT
+
+(require racket/list racket/match racket/set syntax/id-table data/interval-map
+         "internal-types.rkt" "lexer.rkt" "binding-facts.rkt"
+         "../common/source.rkt" "../common/interfaces.rkt")
+
+(provide identifier-name renamed-text rename-offset rename-snapshot
+         rename-correspondence validate-rename-proposal rename-token-relations
+         rename-module-binding)
+
+(define (refuse) (error 'rename "Renaming would change another binding or an incomplete binding family."))
+
+(define (identifier-name text)
+  (with-handlers ([exn:fail? (lambda (_) #f)])
+    (parameterize ([read-accept-reader #f] [read-accept-lang #f])
+      (define in (open-input-string text))
+      (define value (read in))
+      (and (symbol? value) (eof-object? (read in))
+           (equal? text (format "~s" value)) value))))
+
+(define (renamed-text text ranges name)
+  (define out (open-output-string))
+  (define end
+    (for/fold ([start 0]) ([range (in-list ranges)])
+      (write-string text out start (car range))
+      (display name out)
+      (cdr range)))
+  (write-string text out end)
+  (get-output-string out))
+
+;; Cumulative deltas include replacements ending exactly at the queried offset.
+(define (rename-offset ranges name)
+  (define ends (list->vector (map cdr ranges)))
+  (define deltas (make-vector (add1 (vector-length ends)) 0))
+  (for ([range (in-list ranges)] [i (in-naturals)])
+    (vector-set! deltas (add1 i)
+                 (+ (vector-ref deltas i) (- (string-length name) (- (cdr range) (car range))))))
+  (lambda (offset)
+    (let loop ([lo 0] [hi (vector-length ends)])
+      (if (= lo hi) (+ offset (vector-ref deltas lo))
+          (let ([mid (quotient (+ lo hi) 2)])
+            (if (<= (vector-ref ends mid) offset)
+                (loop (add1 mid) hi) (loop lo mid)))))))
+
+(define (rename-module-binding fact)
+  (define binding (hash-ref fact 'binding #f))
+  (define space (hash-ref fact 'space #f))
+  (and binding
+       (if (and space (not (pair? (Module-Binding-phase+space binding))))
+           (struct-copy Module-Binding binding [phase+space (cons (Module-Binding-phase+space binding) space)])
+           binding)))
+
+(define (rename-token-relations text uri ranges name correspondence query [shift (rename-offset ranges name)])
+  (for/list ([token (in-lexer-snapshot (build-lexer-snapshot text uri))]
+             #:when (eq? (LexerEntry-type token) 'symbol))
+    (define binding (query (LexerEntry-start token)))
+    (list (shift (LexerEntry-start token)) (shift (LexerEntry-end token))
+          (cond [(set? binding)
+                 (for/set ([owner (in-set binding)]) (hash-ref correspondence owner owner))]
+                [(pair? binding) (cons (shift (car binding)) (shift (cdr binding)))]
+                [else #f]))))
+
+;; Resolve scoped local identities while their expansion is still available.
+;; Structural positions include the core role, module nesting, phase and space;
+;; printed generated names never establish correspondence.
+(define (rename-snapshot facts source text paths)
+  (unless facts (refuse))
+  (define-values (tables binders) (values (make-hash) (make-hash)))
+  ;; Shared tails are visited once; both analyses share the same compact IDs.
+  ;; Atomic path elements and pairs of IDs occupy distinct interning keys.
+  (define memo (make-hasheq))
+  (define (path value)
+    (hash-ref! memo value
+      (lambda ()
+        (define key (if (pair? value) (cons (path (car value)) (path (cdr value))) value))
+        (hash-ref! paths key (lambda () (hash-count paths))))))
+  (define (table fact)
+    (hash-ref! tables (cons (hash-ref fact 'phase 0) (hash-ref fact 'space #f))
+               (lambda () (make-free-id-table #:phase (hash-ref fact 'phase 0)))))
+  (define (anchor fact)
+    (list (path (hash-ref fact 'anchor)) (hash-ref fact 'role)
+          (hash-ref fact 'phase 0) (hash-ref fact 'space #f)))
+  (define (range id)
+    (and (equal? (syntax-source id) (source-syntax-source source))
+         (syntax-position id) (syntax-span id)
+         (cons (sub1 (syntax-position id)) (+ (sub1 (syntax-position id)) (syntax-span id)))))
+  (define (external-owner fact)
+    (define binding (identifier-binding (hash-ref fact 'identifier) (hash-ref fact 'phase 0)))
+    (and (list? binding)
+         (list 'external (resolved-module-path-name (module-path-index-resolve (car binding)))
+               (cadr binding) (list-ref binding 4) (hash-ref fact 'space #f))))
+  (define (bound-owner fact)
+    (or (free-id-table-ref (table fact) (hash-ref fact 'identifier) #f)
+        (rename-module-binding fact)
+        (let ([binding (identifier-binding (hash-ref fact 'identifier) (hash-ref fact 'phase 0))])
+          (and (list? binding)
+               (let-values ([(path base) (module-path-index-split (car binding))])
+                 (and path (external-owner fact)))))))
+  (for ([fact (in-list (hash-ref facts 'binders))])
+    (define-values (id key) (values (hash-ref fact 'identifier) (anchor fact)))
+    (when (hash-has-key? binders key) (refuse))
+    (define binding (bound-owner fact))
+    (define owner
+      (if (and (not (range id)) (Module-Binding? binding)
+               (equal? (Module-Binding-filepath binding) (source-file-path source)))
+          ;; A private generated name keeps its structural owner and scoped uses.
+          (cons 'local key)
+          (or binding (cons 'local key))))
+    (free-id-table-set! (table fact) id owner)
+    (hash-set! binders key (list owner (range id) (syntax-e id))))
