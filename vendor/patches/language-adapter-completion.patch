+              (send doc-trace get-online-completions online-prefix)))
+    (define result
+      (for/list ([completion (in-list completions)])
+        (CompletionItem #:label (symbol->string completion) #:textEdit (Nothing))))
+    (CompletionList #:isIncomplete #t
